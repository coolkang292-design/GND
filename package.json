{
  "name": "workout-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:avatar-coordinate": "vitest run src/lib/domain/avatar-coordinate-items.test.ts src/components/profile/avatar-coordinate-preview.test.tsx src/components/profile/avatar-shop-mock.test.tsx src/components/profile/avatar-shop-entry.test.tsx src/components/profile/growth-hub-avatar-entry.test.ts \"src/app/(tabs)/profile/avatar-mock/page.test.tsx\" && pnpm validate:avatar-assets",
    "validate:avatar-assets": "node scripts/validate-avatar-coordinate-assets.mjs",
    "typecheck": "tsc --noEmit",
    "release:notify": "node scripts/broadcast-release.mjs",
    "db:snapshot": "node scripts/dump-schema-snapshot.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.1",
    "@supabase/supabase-js": "^2.110.3",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
