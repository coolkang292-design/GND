# GND 환경변수 — 이 파일을 .env.local로 복사한 뒤 값을 채운다.
#
# ⚠️ .env.local은 **운영 Supabase**에 붙는다. 스테이징 DB가 없다(CLAUDE.md §개발 환경).
# ⚠️ 값이 비어도 앱은 대부분 뜬다. **조용히 죽는 기능**을 아래 각 항목에 적어 뒀다.
# ⚠️ NEXT_PUBLIC_ 로 시작하는 값은 빌드 시각에 번들로 박힌다 — 고치면 **다시 빌드**해야 한다.
#    Vercel에서는 환경변수를 바꾼 뒤 재배포해야 반영된다.


# ─────────────────────────────────────────────────────────────
# 1. Supabase — 없으면 앱이 아예 안 뜬다
#    https://supabase.com/dashboard → Project Settings → API
# ─────────────────────────────────────────────────────────────

# Authentication → Providers → Anonymous Sign-ins 를 켜야 익명 인증이 동작한다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role 키 (Project Settings → API → service_role, "secret" 쪽).
#
# ⚠️ RLS를 통째로 우회한다. NEXT_PUBLIC_ 접두사 금지 — 붙이면 클라이언트 번들에
#    실려 아무나 전체 DB를 읽고 쓴다.
# 없으면 죽는 것:
#   · /api/briefing        → 500 env_missing. 아침 브리핑과 챌린지 자동 시작·종료가 안 돈다
#   · /api/push/notify     → service_role 조회 불가로 푸시 발송 실패
#   · scripts/*.mjs 전량   → "Supabase 설정이 없습니다"로 즉시 종료
SUPABASE_SERVICE_ROLE_KEY=


# ─────────────────────────────────────────────────────────────
# 2. 계정 연결 (카카오·구글)
# ─────────────────────────────────────────────────────────────

# 쓸 수 있는 값: kakao, google — 쉼표 구분.
#
# ⚠️ 비워두면 연결 버튼이 하나도 안 뜬다(fail-closed). Supabase 대시보드 설정
#    (Auth → Providers 활성화 + Manual linking 허용 + Redirect URLs)이 끝나기
#    전에 켜면, 누르면 실패하는 버튼이 온보딩 첫 화면에 놓인다 — 그건 신규
#    사용자가 아예 앱에 못 들어오는 일이다.
# ⚠️ 값을 바꾸면 **다시 빌드해야 한다.** Next가 빌드 시각에 이 문자열을 번들에
#    박아 넣는다. Vercel에서는 환경변수를 고친 뒤 재배포해야 반영된다.
NEXT_PUBLIC_OAUTH_PROVIDERS=kakao,google


# ─────────────────────────────────────────────────────────────
# 3. 관리자 대시보드 (/admin) — 거부는 전부 404다
# ─────────────────────────────────────────────────────────────

# 접근 허용 uuid — 쉼표 구분. 비워두면 이 경로로는 아무도 못 들어온다(fail-closed).
# NEXT_PUBLIC_ 접두사 금지.
ADMIN_USER_IDS=

# 암호키 — /admin?key=… 로 들어오면 미들웨어가 httpOnly 쿠키로 옮겨 심는다(180일).
#
# 익명 인증이라 브라우저마다 계정이 다르다. 즉 ADMIN_USER_IDS만 채우면
# **새 기기·새 브라우저에서는 대시보드를 영영 열 수 없다.** 이 키가 그 통로다.
# 없으면 죽는 것: 새 기기에서 /admin 접근 (기존 기기는 쿠키가 남아 있어 멀쩡하다)
ADMIN_ACCESS_KEY=

# (선택) 통계에서 뺄 uuid — 쉼표 구분.
# 규칙(@gnd.local 이메일, 닉네임 'test')으로 안 잡히는 계정을 코드 수정 없이 제외한다.
# 비워도 된다 — 그러면 규칙에 걸리는 계정만 빠진다.
ANALYTICS_EXCLUDED_USER_IDS=


# ─────────────────────────────────────────────────────────────
# 4. 웹 푸시 — 여기가 제일 조용히 죽는다
#    키 생성: npx web-push generate-vapid-keys
# ─────────────────────────────────────────────────────────────

# ⚠️ 셋 중 하나라도 비면 /api/push/notify가 500 env_missing을 돌려준다.
#    그런데 알림 INSERT 트리거(0016)는 DB에 행을 먼저 만든다 —
#    즉 **앱 안의 알림 벨은 정상으로 보이고 폰 푸시만 안 온다.**
#    "알림이 안 와요" 신고가 들어오면 코드보다 이 세 줄을 먼저 본다.
# ⚠️ 공개키를 바꾸면 기존 구독이 전부 무효가 된다. 사용자가 알림을 다시 켜야 한다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# 푸시 서비스에 보내는 연락처. mailto: 또는 https: URL이어야 한다.
# 예: mailto:you@example.com
VAPID_SUBJECT=


# ─────────────────────────────────────────────────────────────
# 5. 크론 — 하루 한 번 09:00 KST
# ─────────────────────────────────────────────────────────────

# Vercel Cron이 /api/briefing을 부를 때 쓰는 Bearer 토큰 (vercel.json의 crons).
# Vercel 대시보드의 환경변수에도 **같은 값**이 있어야 한다.
#
# 없으면 죽는 것: 아침 브리핑 발송 + 챌린지 자동 시작·종료(0044).
#   ⚠️ 크론은 매일 조용히 500을 받고 끝난다. 앱 화면에는 아무 표시도 안 난다.
#   ⚠️ 챌린지가 시작일이 지나도 setup에 머물러 있으면 이걸 먼저 의심한다.
CRON_SECRET=


# ─────────────────────────────────────────────────────────────
# 6. 개발 전용
# ─────────────────────────────────────────────────────────────

# 픽스처 계정 dev-테스터A / dev-테스터B 의 공용 비밀번호.
# 사회적 기능(알림·크루·챌린지·응원·찌르기)은 두 계정으로 양쪽 화면을 봐야 한다
# — CLAUDE.md §사회적 기능. 만들기: node scripts/dev-fixture.mjs create
#
# 없으면 죽는 것: dev-fixture.mjs / unlink-identity.mjs 의 로그인 단계
DEV_FIXTURE_PASSWORD=


# ─────────────────────────────────────────────────────────────
# 여기에 넣지 않는 것
# ─────────────────────────────────────────────────────────────
#
# VERCEL_OIDC_TOKEN
#   Vercel CLI가 .env.local에 자동으로 써 넣는다. 손으로 채우지 않는다.
#
# GND_ALLOW_DB_TESTS
#   운영 DB를 건드리는 스크립트의 명시 승인값이다. 실행할 때 한 번만 넘긴다:
#     $env:GND_ALLOW_DB_TESTS='workout-plan'; node scripts/workout-plan-test.mjs
#   .env.local에 박아 두면 가드가 상시 열려 **의도치 않은 실행을 못 막는다.**
#
# BADGE_SHEETS
#   scripts/slice-badge-sheets.mjs의 원본 폴더 경로. 기본값 '배지이미지'로 충분하다.
