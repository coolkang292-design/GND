# Supabase 프로젝트 설정 (https://supabase.com/dashboard → Project Settings → API)
# 이 파일을 .env.local로 복사한 뒤 값을 채우세요.
# Authentication → Providers → Anonymous Sign-ins 를 켜야 익명 인증이 동작합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 관리자 대시보드(/admin) 접근 허용 uuid — 쉼표 구분.
# 비워두면 아무도 접근할 수 없다(fail-closed). NEXT_PUBLIC_ 접두사 금지.
ADMIN_USER_IDS=

# 계정 연결(카카오·구글) 제공자 — 쉼표 구분. 쓸 수 있는 값: kakao, google
#
# ⚠️ 비워두면 연결 버튼이 하나도 안 뜬다(fail-closed). Supabase 대시보드 설정
#    (Auth → Providers 활성화 + Manual linking 허용 + Redirect URLs)이 끝나기
#    전에 켜면, 누르면 실패하는 버튼이 온보딩 첫 화면에 놓인다 — 그건 신규
#    사용자가 아예 앱에 못 들어오는 일이다.
# ⚠️ 값을 바꾸면 **다시 빌드해야 한다.** Next가 빌드 시각에 이 문자열을 번들에
#    박아 넣는다. Vercel에서는 환경변수를 고친 뒤 재배포해야 반영된다.
NEXT_PUBLIC_OAUTH_PROVIDERS=kakao,google
